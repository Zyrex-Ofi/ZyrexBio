# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
coverage

# Cache
.cache
.turbo
.eslintcache
*.tsbuildinfo

# Instance configuration (config.yml is operator content, keep .example tracked)
/config.yml
/config.yml.reload
*.reload

# Environment
.env
.env.local
.env.*.local

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temp
*.tmp
temp

# TLS certificates (user-provided or auto-generated).
# The root `certs/*` line below never matched apps/backend/certs/, so the
# GENERATED apps/backend/certs/custom-domains.conf slipped into 631ba0d.
# It is rewritten by the backend at runtime (ACME/nginx generator) and must
# not be versioned — untrack it with:
#   git rm --cached apps/backend/certs/custom-domains.conf
certs/*
!certs/.gitkeep
apps/backend/certs/*

# Local verification tooling
checks/

# Uploads (user-generated files, e.g. avatars/banners; LOCAL_STORAGE_PATH)
uploads/

# Data
data/

# Databases & backups (may contain real credentials/data)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.bak
*.sql.gz
*.sql.zip
pgdata/
postgres_data/
backups/
pg_dump*.sql
.pgpass
